# KirubAI Backend Environment Variables
# Copy to .env for local backend development

APP_NAME="KirubAI API"
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL)
DATABASE_URL=postgresql://kirubai:kirubai@localhost:5432/kirubai

# JWT Auth
JWT_SECRET_KEY=dev-secret-change-in-production-use-strong-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
