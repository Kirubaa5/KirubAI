# ==============================================================================
# KirubAI Environment Configuration Template
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application Settings
APP_NAME="KirubAI API"
ENVIRONMENT=development
DEBUG=true

# Database Connection
# Local Docker: postgresql://kirubai:kirubai@localhost:5432/kirubai
# Supabase: postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://kirubai:kirubai@localhost:5432/kirubai

# JWT Authentication
# In production, generate a strong random 64-character secret (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=dev-secret-change-in-production-use-strong-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Allowed Origins (comma-separated list)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM Provider Configuration (mock | gemini | openai | openrouter)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Frontend API URL (Vite)
VITE_API_URL=http://localhost:8000/api/v1
