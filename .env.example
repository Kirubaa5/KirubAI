# Application
APP_NAME=KirubAI API
DEBUG=true

# Database (Local Docker Postgres)
DATABASE_URL=postgresql://kirubai:kirubai@localhost:5432/kirubai

# JWT Authentication
JWT_SECRET_KEY=dev-secret-change-in-production-use-strong-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM Configuration
LLM_PROVIDER=mock
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# Frontend (Vite)
VITE_API_URL=http://localhost:8000/api/v1
