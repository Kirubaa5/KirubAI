# ==============================================================================
# KirubAI Environment Configuration
# Copy this file to .env and adjust values for your environment.
# ==============================================================================

# Application Settings
APP_NAME="KirubAI API"
ENVIRONMENT=development # development | testing | production
DEBUG=true

# Database Connection
# Local Docker: postgresql://kirubai:kirubai@localhost:5432/kirubai
# Supabase Production (Connection Pooler / Direct):
# postgresql://postgres.<PROJECT_REF>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres
DATABASE_URL=postgresql://kirubai:kirubai@localhost:5432/kirubai

# JWT Authentication
# In production, generate a strong random 64-character secret (e.g. `openssl rand -hex 32`)
JWT_SECRET_KEY=dev-secret-change-in-production-use-strong-random-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS Allowed Origins (comma-separated list for production)
# Example: https://kirubai.vercel.app,http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# LLM Provider Configuration
# Supported providers: mock | openai | gemini | openrouter
LLM_PROVIDER=mock

# Provider API Keys (required only if LLM_PROVIDER is set to the respective provider)
OPENAI_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# ==============================================================================
# Frontend Environment Variables (Vite)
# When deploying frontend on Vercel, set VITE_API_URL to your deployed Render URL:
# VITE_API_URL=https://kirubai-backend.onrender.com/api/v1
# ==============================================================================
VITE_API_URL=http://localhost:8000/api/v1
